# ── Where things run ────────────────────────────────────────────────
# Public site (landing page + tip pages). This is what guests see.
PORT=3000
# Public base URL. It is baked into every QR code / NFC link, so set it
# to your real domain BEFORE you print stickers, e.g. https://tipper.ge
PUBLIC_URL=http://localhost:3000

# Admin panel — a SEPARATE server on a SEPARATE port/host. It is not
# reachable from the public site. Default binds to localhost only.
ADMIN_PORT=3001
ADMIN_HOST=127.0.0.1

# ── Storage ─────────────────────────────────────────────────────────
DATA_DIR=./data

# ── Site ────────────────────────────────────────────────────────────
# Language used when the guest has not picked one: en | ka
DEFAULT_LANG=en
CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=

# ── Tips ────────────────────────────────────────────────────────────
# Limits in GEL
MIN_TIP=1
MAX_TIP=200
# Default platform fee in percent (changeable later in the admin panel)
DEFAULT_FEE_PERCENT=9

# ── Payments ────────────────────────────────────────────────────────
# demo = simulated payments, NO real money moves. See README.
PAYMENT_PROVIDER=demo

# ── Production hosting ──────────────────────────────────────────────
NODE_ENV=development
# Set to 1 when running behind a reverse proxy / PaaS (Nginx, Render, Fly…)
TRUST_PROXY=0
# Force Secure cookies for the admin login (automatic when NODE_ENV=production)
COOKIE_SECURE=0
